---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AboutContent from '../components/pages/AboutContent.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Sobre JuanSa Digital y Juan Salinas Calle",
  "description": "Consultoría tecnológica, marketing turístico y analítica de datos con arraigo territorial en Santa Marta y el Caribe colombiano.",
  "mainEntity": {
    "@type": "Person",
    "name": "Juan Salinas Calle",
    "jobTitle": "Estratega de Marketing Turístico & Desarrollador Web",
    "worksFor": {
      "@type": "Organization",
      "name": "JuanSa Digital"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Santa Marta",
      "addressRegion": "Magdalena",
      "addressCountry": "CO"
    },
    "sameAs": [
      "https://www.linkedin.com/company/juansadigital",
      "https://github.com/JuansaDigital",
      "https://www.instagram.com/juansadigital/"
    ]
  }
};
---

<Layout 
  lang="es"
  title="Nosotros | JuanSa Digital · Estudio de Estrategia Turística & Desarrollo Web"
  description="Conoce a JuanSa Digital: consultoría tecnológica, marketing turístico y analítica de datos en Santa Marta, Colombia. Nuestra filosofía, metodología y clientes."
  keywords="juan salinas calle"
  pageSchema={aboutSchema}
>
  <Navbar />
  <AboutContent lang="es" />
  <Footer />
</Layout>
