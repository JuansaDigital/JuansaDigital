---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BlogContent from '../../../components/pages/BlogContent.astro';

const blogIndexSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Tourism Marketing & Web Engineering Blog | JuanSa Digital",
  "description": "Technical guides, articles, and insights on web development, SEO, and analytics in Santa Marta and the Colombian Caribbean.",
  "publisher": {
    "@type": "Organization",
    "name": "JuanSa Digital"
  }
};
---

<Layout 
  lang="en"
  title="Blog & Insights | JuanSa Digital · Santa Marta, Colombia"
  description="Technical guides, perspectives, and case studies on WordPress & Astro web engineering, destination marketing, SEO, and data analytics in the Colombian Caribbean."
  keywords="tourism marketing blog"
  pageSchema={blogIndexSchema}
>
  <Navbar />
  <BlogContent lang="en" />
  <Footer />
</Layout>
