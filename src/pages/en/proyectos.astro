---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectsContent from '../../components/pages/ProjectsContent.astro';

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Portfolio & Case Studies | JuanSa Digital",
  "description": "Selected case studies in regional destination platforms, boutique eco-lodges, and software engineering.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Hotel Parque Tayrona (Yachay)" },
      { "@type": "ListItem", "position": 2, "name": "Wiwa Tour · Sierra Nevada" },
      { "@type": "ListItem", "position": 3, "name": "Visit Valle del Cauca" },
      { "@type": "ListItem", "position": 4, "name": "Discover La Guajira" },
      { "@type": "ListItem", "position": 5, "name": "Providencia Isla" },
      { "@type": "ListItem", "position": 6, "name": "Ciudad Perdida Santa Marta" },
      { "@type": "ListItem", "position": 7, "name": "Chez Boaz Tours" },
      { "@type": "ListItem", "position": 8, "name": "Logan Valuation" },
      { "@type": "ListItem", "position": 9, "name": "TurisData & SITUR Valledupar" }
    ]
  }
};
---

<Layout 
  lang="en"
  title="Projects | JuanSa Digital · Selected Case Studies & Portfolio"
  description="Explore the JuanSa Digital portfolio: government tourism portals, direct booking hospitality platforms, multinational consulting, and territorial BI software."
  keywords="tourism web development projects"
  pageSchema={projectsSchema}
>
  <Navbar />
  <ProjectsContent lang="en" />
  <Footer />
</Layout>
