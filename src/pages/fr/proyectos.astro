---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProjectsContent from '../../components/pages/ProjectsContent.astro';

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Portfolio de Projets & Études de Cas | JuanSa Digital",
  "description": "Succès avérés en tourisme territorial, hôtellerie de charme et plateformes d'analyse de données.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Hotel Parque Tayrona (Yachay)" },
      { "@type": "ListItem", "position": 2, "name": "Wiwa Tour · Sierra Nevada" },
      { "@type": "ListItem", "position": 3, "name": "Visit Valle del Cauca" },
      { "@type": "ListItem", "position": 4, "name": "Discover La Guajira" },
      { "@type": "ListItem", "position": 5, "name": "Providencia Isla" },
      { "@type": "ListItem", "position": 6, "name": "Ciudad Perdida Santa Marta" },
      { "@type": "ListItem", "position": 7, "name": "Chez Boaz Tours" },
      { "@type": "ListItem", "position": 8, "name": "Logan Valuation" },
      { "@type": "ListItem", "position": 9, "name": "TurisData & SITUR Valledupar" }
    ]
  }
};
---

<Layout 
  lang="fr"
  title="Projets | JuanSa Digital · Portfolio et Études de Cas"
  description="Découvrez le portfolio de JuanSa Digital : portails de tourisme institutionnel, moteurs de réservation directe, cabinets d'expertise et observatoires de données."
  keywords="projets développement web tourisme"
  pageSchema={projectsSchema}
>
  <Navbar />
  <ProjectsContent lang="fr" />
  <Footer />
</Layout>
