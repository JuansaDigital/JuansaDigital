---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectsContent from '../components/pages/ProjectsContent.astro';

const projectsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Portafolio de Proyectos y Casos de Estudio | JuanSa Digital",
  "description": "Casos de éxito en turismo regional, eco-hoteles y desarrollo de plataformas web.",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Hotel Parque Tayrona (Yachay)" },
      { "@type": "ListItem", "position": 2, "name": "Wiwa Tour · Sierra Nevada" },
      { "@type": "ListItem", "position": 3, "name": "Visit Valle del Cauca" },
      { "@type": "ListItem", "position": 4, "name": "Discover La Guajira" },
      { "@type": "ListItem", "position": 5, "name": "Providencia Isla" },
      { "@type": "ListItem", "position": 6, "name": "Ciudad Perdida Santa Marta" },
      { "@type": "ListItem", "position": 7, "name": "Chez Boaz Tours" },
      { "@type": "ListItem", "position": 8, "name": "Logan Valuation" },
      { "@type": "ListItem", "position": 9, "name": "TurisData & SITUR Valledupar" }
    ]
  }
};
---

<Layout 
  lang="es"
  title="Proyectos | JuanSa Digital · Portafolio y Casos de Estudio"
  description="Explora el portafolio de JuanSa Digital: portales de turismo gubernamental, plataformas de reservas directas, firmas multinacionales y sistemas de datos."
  keywords="proyectos desarrollo web turismo"
  pageSchema={projectsSchema}
>
  <Navbar />
  <ProjectsContent lang="es" />
  <Footer />
</Layout>
