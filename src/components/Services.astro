const c = copy[currentLang] || copy.es;
---

<section class="section-gap studio-services-section section-paper" id="servicios">
  <div class="container">
    <div class="section-top-bar">
      <div>
        <span class="studio-section-label">{c.label}</span>
        <h2 class="section-headline">{c.headline}</h2>
      </div>
      <p class="section-counter">{c.counter}</p>
    </div>

    <div class="studio-services-list">
      {c.items.map((service) => (
        <article class="service-block">
          <div class="service-left">
            <span class="service-num">{service.num}</span>
            <h3 class="service-name">{service.name}</h3>
          </div>
          
          <div class="service-center">
            <p class="service-summary">
              {service.summary}
            </p>
            <ul class="service-points">
              {service.points.map((pt) => (
                <li><strong>{pt.bold}</strong> {pt.text}</li>
              ))}
            </ul>
          </div>

          <div class="service-right">
            <a href={getLocalizedPath("/servicios", currentLang)} class="service-arrow-btn" aria-label={service.ariaLabel}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="services-bottom-action">
      <a href={getLocalizedPath("/servicios", currentLang)} class="pill-morph-btn">
        <span>{c.bottomBtn}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .section-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-light);
    margin-bottom: 3.5rem;
  }

  .studio-section-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--contra-red);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-counter {
    font-size: 0.88rem;
    color: var(--ink-dim);
    font-weight: 500;
  }

  /* Services List */
  .studio-services-list {
    display: flex;
    flex-direction: column;
  }

  .service-block {
    display: grid;
    grid-template-columns: 320px 1fr 60px;
    gap: 3rem;
    padding-block: 3.5rem;
    border-bottom: 1px solid var(--line-light);
    align-items: start;
    transition: background-color 0.25s ease;
  }

  .service-block:hover {
    background-color: rgba(0, 0, 0, 0.015);
  }

  .service-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .service-num {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--contra-red);
    letter-spacing: -0.02em;
  }

  .service-name {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
  }

  .service-summary {
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .service-points {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
  }

  .service-points li {
    font-size: 0.92rem;
    color: var(--ink-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.25rem;
  }

  .service-points li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--contra-red);
    font-weight: 700;
  }

  .service-points li strong {
    color: var(--ink-primary);
  }

  .service-right {
    display: flex;
    justify-content: flex-end;
  }

  .service-arrow-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-primary);
    text-decoration: none;
    transition: all 0.3s var(--ease-contra);
  }

  .service-block:hover .service-arrow-btn {
    background-color: var(--contra-black);
    color: #FFFFFF;
    border-color: var(--contra-black);
    transform: rotate(45deg);
  }

  .services-bottom-action {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }

  @media (max-width: 980px) {
    .service-block {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .service-points {
      grid-template-columns: 1fr;
    }
    .service-right {
      justify-content: flex-start;
    }
  }
</style>
