---
import { getBlogPosts } from '../data/blogPosts';
import { getLangFromUrl, getLocalizedPath, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang: propLang } = Astro.props;
const currentLang = propLang || getLangFromUrl(Astro.url);
const posts = getBlogPosts(currentLang);

const copy = {
  es: {
    label: "Artículos & Perspectivas",
    headline: "Publicaciones",
    allPosts: "Ver todas las publicaciones",
    readArticle: "Leer artículo"
  },
  en: {
    label: "Articles & Perspectives",
    headline: "Publications",
    allPosts: "View all publications",
    readArticle: "Read article"
  },
  fr: {
    label: "Articles & Perspectives",
    headline: "Publications",
    allPosts: "Voir toutes les publications",
    readArticle: "Lire l'article"
  }
};

const c = copy[currentLang] || copy.es;
---

<section class="section-gap studio-blog-section section-paper" id="blog">
  <div class="container">
    <div class="section-top-bar">
      <div>
        <span class="studio-section-label">{c.label}</span>
        <h2 class="section-headline">{c.headline}</h2>
      </div>
      <a href={getLocalizedPath(currentLang, "/blog")} class="all-posts-top-link">
        <span>{c.allPosts}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>

    <div class="studio-articles-list">
      {posts.map((post) => (
        <article class="article-row">
          <a href={getLocalizedPath(currentLang, `/blog/${post.slug}`)} class="article-link">
            <div class="article-meta">
              <span class="article-category">{post.category}</span>
              <span class="article-date">{post.date}</span>
            </div>
            
            <div class="article-body">
              <h3 class="article-title">{post.title}</h3>
              <p class="article-excerpt">{post.excerpt}</p>
            </div>

            <div class="article-action">
              <span class="read-indicator">
                <span>{c.readArticle}</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .studio-blog-section {
    border-top: 1px solid var(--line-light);
  }

  .section-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-light);
    margin-bottom: 2rem;
  }

  .studio-section-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--contra-orange);
    display: block;
    margin-bottom: 0.5rem;
  }

  .all-posts-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink-primary);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .all-posts-top-link:hover {
    color: var(--contra-red);
    transform: translateX(3px);
  }

  .studio-articles-list {
    display: flex;
    flex-direction: column;
  }

  .article-row {
    border-bottom: 1px solid var(--line-light);
    transition: background-color 0.2s ease;
  }

  .article-row:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .article-link {
    display: grid;
    grid-template-columns: 220px 1fr 180px;
    gap: 2.5rem;
    padding-block: 2.5rem;
    text-decoration: none;
    color: inherit;
    align-items: baseline;
  }

  .article-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .article-category {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--contra-red);
  }

  .article-date {
    font-size: 0.88rem;
    color: var(--ink-dim);
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .article-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .article-link:hover .article-title {
    color: var(--contra-red);
  }

  .article-excerpt {
    font-size: 0.96rem;
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .article-action {
    display: flex;
    justify-content: flex-end;
  }

  .read-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-primary);
    transition: transform 0.25s var(--ease-smooth);
  }

  .article-link:hover .read-indicator {
    transform: translateX(4px);
    color: var(--contra-red);
  }

  @media (max-width: 900px) {
    .article-link {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .article-action {
      justify-content: flex-start;
    }
  }
</style>
