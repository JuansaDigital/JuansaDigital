const c = copy[currentLang] || copy.es;
const partners = c.partners;
---

<section class="section-gap contra-partners-section section-paper">
  <div class="container">
    <div class="partners-title-block">
      <span class="contra-section-label">{c.label}</span>
      <h2 class="section-headline">
        {c.headline}
      </h2>
    </div>

    <!-- Horizontal Partners media track -->
    <div class="media_wrapper" tabindex="0" aria-label={c.ariaLabel}>
      <div class="media_track">
        {partners.map((partner) => (
          <article class="partner-media-card">
            <div class="card-top">
              <span class="partner-category">{partner.category}</span>
              <span class="partner-metric-tag">{partner.metric}</span>
            </div>

            <h3 class="partner-name">{partner.name}</h3>

            <p class="partner-quote">
              &ldquo;{partner.quote}&rdquo;
            </p>

            <div class="card-bottom">
              <span class="partner-author">{partner.author}</span>
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="partner-link-icon" aria-label={`Ver sitio de ${partner.name}`}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .contra-partners-section {
    border-top: 1px solid var(--line-light);
    overflow: hidden;
  }

  .partners-title-block {
    max-width: 980px;
    margin-bottom: 3.5rem;
  }

  .contra-section-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--contra-red);
    display: block;
    margin-bottom: 1rem;
  }

  /* Scrollbar & Media Track */
  .media_wrapper {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 1.75rem;
    cursor: grab;
    user-select: none;

    /* Firefox */
    scrollbar-width: thin;
    scrollbar-color: var(--contra-black) transparent;
  }

  .media_wrapper:active {
    cursor: grabbing;
  }

  /* Chrome, Edge, Safari */
  .media_wrapper::-webkit-scrollbar {
    height: 6px;
  }

  /* Track sutil con fade lateral */
  .media_wrapper::-webkit-scrollbar-track {
    background: linear-gradient(
      to right,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.18) 20%,
      rgba(0,0,0,0.18) 80%,
      rgba(0,0,0,0) 100%
    );
    border-radius: 999px;
  }

  /* THUMB (3px centrado) */
  .media_wrapper::-webkit-scrollbar-thumb {
    background: var(--contra-black);
    border-radius: 999px;
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
    background-clip: content-box;
  }

  .media_wrapper::-webkit-scrollbar-thumb:hover {
    background: var(--contra-red);
  }

  .media_track {
    display: flex;
    gap: 2rem;
    min-width: min-content;
  }

  .partner-media-card {
    background: #FFFFFF;
    border: 1px solid var(--line-light);
    border-radius: 14px;
    padding: clamp(2rem, 3.5vw, 2.75rem);
    width: clamp(320px, 32vw, 420px);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .partner-media-card:hover {
    transform: translateY(-4px);
    border-color: var(--contra-black);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .partner-category {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--ink-dim);
  }

  .partner-metric-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--contra-red);
    background: rgba(236, 58, 58, 0.08);
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .partner-name {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink-primary);
    margin-bottom: 1rem;
  }

  .partner-quote {
    font-size: 1rem;
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-light);
  }

  .partner-author {
    font-size: 0.85rem;
    color: var(--ink-dim);
    font-weight: 600;
  }

  .partner-link-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-primary);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .partner-media-card:hover .partner-link-icon {
    background: var(--contra-black);
    color: #FFFFFF;
    border-color: var(--contra-black);
    transform: rotate(45deg);
  }
</style>
