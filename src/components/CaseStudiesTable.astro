  {
    name: "Logan Valuation",
    url: "http://loganvaluation.com/",
    category: "Firma Institucional de Avalúos",
    region: "América Latina (COL, MEX, PER, PAN, CRI)",
    stack: "WordPress · Elementor · JetEngine · WPML",
    highlight: "Consultoría y valuación bajo estándares MAI e IFRS/NIIF para fondos de inversión y banca internacional."
  },
  {
    name: "Discover La Guajira",
    url: "https://discoverlaguajira.travel",
    category: "Destino Gubernamental",
    region: "La Guajira, Colombia",
    stack: "WordPress · JetEngine · Elementor · SEO",
    highlight: "Plataforma oficial para promover la identidad Wayuu, el desierto y la cultura con arquitectura SEO avanzada."
  },
  {
    name: "Visit Valle",
    url: "https://visitvalle.travel",
    category: "Destino Gubernamental",
    region: "Valle del Cauca, Colombia",
    stack: "WordPress · JetEngine · Elementor · SEO",
    highlight: "Portal turístico departamental enfocado en turismo cultural, la salsa y los pueblos mágicos."
  },
  {
    name: "Providencia Isla",
    url: "https://providenciaisla.travel",
    category: "Destino Gubernamental",
    region: "Archipiélago de San Andrés y Providencia",
    stack: "WordPress · JetEngine · Elementor · SEO",
    highlight: "Sitio web dinámico enfocado en la conservación, ecosistemas marinos y la experiencia del viajero isleño."
  },
  {
    name: "Wiwa Tour",
    url: "https://wiwatour.com",
    category: "Operador Turístico & Reservas",
    region: "Santa Marta & Sierra Nevada",
    stack: "WordPress · JetEngine · Motor de Reservas",
    highlight: "Plataforma con sistema de reservas directas para trekking a Ciudad Perdida operado por guías indígenas ancestrales."
  },
  {
    name: "Tornus Agency",
    url: "https://tornus.agency",
    category: "Placebranding & Estudio Creativo",
    region: "Colombia",
    stack: "WordPress · JetEngine · Elementor",
    highlight: "Agencia de placebranding y narrativas territoriales con producción de branded content para destinos."
  },
  {
    name: "Chez Boaz Tours",
    url: "https://chezboaztours.com/",
    category: "Tours Personalizados",
    region: "Caribe Colombiano",
    stack: "WordPress · JetEngine · SEO",
    highlight: "Experiencias boutique y tours a la medida para captación de clientes de Europa y Norteamérica."
  },
  {
    name: "Ciudad Perdida Santa Marta",
    url: "https://ciudadperdidasantamarta.com/",
    category: "Portal de Destino",
    region: "Santa Marta",
    stack: "WordPress · SEO Técnico",
    highlight: "Plataforma posicionada orgánicamente para búsquedas de alta intención de compra en trekking de montaña."
  },
  {
    name: "Hotel Parque Tayrona (Yachay)",
    url: "https://hotelparquetayrona.com",
    category: "Eco-Hotel & Reservas Directas",
    region: "Parque Nacional Natural Tayrona",
