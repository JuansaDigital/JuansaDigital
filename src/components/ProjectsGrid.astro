---
const projects = [
  {
    title: "Logan Valuation",
    subtitle: "Firma Institucional de Avalúos en Latinoamérica",
    tag: "Valuación · MAI · IFRS",
    image: "/images/logan-valuation.webp",
    url: "http://loganvaluation.com/",
    accent: "var(--contra-blue)"
  },
  {
    title: "Discover La Guajira",
    subtitle: "Portal Gubernamental de Turismo y Cultura",
    tag: "Turismo · SEO · Web",
    image: "/images/discover-guajira.webp",
    url: "https://discoverlaguajira.travel",
    accent: "var(--contra-orange)"
  },
  {
    title: "Visit Valle",
    subtitle: "Plataforma Turística y Destino Departamental",
    tag: "Turismo Cultural · SEO",
    image: "/images/visit-valle.webp",
    url: "https://visitvalle.travel",
    accent: "var(--contra-red)"
  },
  {
    title: "Wiwa Tour",
    subtitle: "Plataforma Integral con Motor de Reservas",
    tag: "Reservas · Ecoturismo",
    image: "/images/wiwa-tour.webp",
    url: "https://wiwatour.com",
    accent: "var(--contra-emerald)"
  },
  {
    title: "Providencia Isla",
    subtitle: "Sitio Web Oficial del Destino Insular",
    tag: "Turismo · Biodiversidad",
    image: "/images/providencia.webp",
    url: "https://providenciaisla.travel",
    accent: "var(--contra-blue)"
  },
  {
    title: "Tornus Agency",
    subtitle: "Estudio Creativo y Placebranding de Destinos",
    tag: "Identidad · Storytelling",
    image: "/images/tornus.webp",
    url: "https://tornus.agency",
    accent: "var(--contra-orange)"
  },
  {
    title: "Chez Boaz Tours",
    subtitle: "Tours Personalizados y Mercado Internacional",
    tag: "Tours Boutique · Web",
    image: "/images/chez-boaz.webp",
    url: "https://chezboaztours.com/",
    accent: "var(--contra-yellow)"
  },
  {
    title: "Ciudad Perdida Santa Marta",
    subtitle: "Portal Especializado con Posicionamiento Orgánico",
    tag: "Destino · SEO Técnico",
    image: "/images/ciudad-perdida.webp",
    url: "https://ciudadperdidasantamarta.com/",
    accent: "var(--contra-red)"
  },
  {
    title: "Hotel Parque Tayrona (Yachay)",
    subtitle: "Eco-Hotel Boutique & Motor de Reservas Directas",
    tag: "Eco-Hotel · Reservas Directas · SEO",
    image: "/images/hotel-tayrona.webp",
    url: "https://hotelparquetayrona.com",
    accent: "var(--contra-emerald)"
  }
];
---

<section class="section-gap projects-section section-black" id="proyectos">
  <div class="container">
    <div class="section-top-bar">
      <div>
        <span class="studio-section-label">Portafolio Seleccionado</span>
        <h2 class="section-headline text-white">Casos de Estudio</h2>
      </div>
      <p class="section-counter">{projects.length} Proyectos Destacados</p>
    </div>

    <!-- Contra Studio Style 2-Column Grid -->
    <div class="contra-projects-grid">
      {projects.map((project) => (
        <article class="project-entry">
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-card-link">
            <div class="project-image-box">
              <img 
                src={project.image} 
                alt={`${project.title} - ${project.subtitle}`} 
                class="project-thumbnail"
                loading="lazy"
              />
              <div class="project-hover-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </div>
            </div>
            
            <!-- Metadata line below image -->
            <div class="project-meta-line">
              <div class="meta-left">
                <h3 class="meta-title">{project.title}</h3>
                <span class="meta-sub">{project.subtitle}</span>
              </div>
              <span class="meta-tag">{project.tag}</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="projects-bottom-action">
      <a href="/proyectos" class="pill-morph-btn-light">
        <span>Explorar Archivo Completo de Proyectos</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .text-white {
    color: #FFFFFF;
  }

  .section-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-dark);
    margin-bottom: 3.5rem;
  }

  .studio-section-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--contra-red);
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-counter {
    font-size: 0.88rem;
    color: var(--ink-dark-dim);
    font-weight: 500;
  }

  /* 2-Column Grid */
  .contra-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem 2.5rem;
  }

  .project-entry {
    display: flex;
    flex-direction: column;
  }

  .project-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    group: relative;
  }

  .project-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: #111520;
    border: 1px solid var(--line-dark);
  }

  .project-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.65s var(--ease-contra);
  }

  .project-card-link:hover .project-thumbnail {
    transform: scale(1.04);
  }

  .project-hover-arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #000000;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translate(-6px, 6px);
    transition: all 0.35s var(--ease-contra);
  }

  .project-card-link:hover .project-hover-arrow {
    opacity: 1;
    transform: translate(0, 0);
    background: var(--contra-red);
  }

  .project-meta-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 1.25rem;
    gap: 1rem;
  }

  .meta-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    transition: color 0.2s ease;
  }

  .project-card-link:hover .meta-title {
    color: var(--contra-red);
  }

  .meta-sub {
    font-size: 0.9rem;
    color: var(--ink-dark-muted);
    line-height: 1.4;
  }

  .meta-tag {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    white-space: nowrap;
    align-self: flex-start;
  }

  .projects-bottom-action {
    display: flex;
    justify-content: center;
    margin-top: clamp(3.5rem, 6vw, 5rem);
  }

  @media (max-width: 900px) {
    .contra-projects-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
