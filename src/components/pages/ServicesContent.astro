---

<main id="main-content" class="services-page section-paper">
  <!-- Header with animated reveals -->
  <section class="studio-page-header">
    <div class="container">
      <div class="header-tag-row reveal-on-scroll">
        <span class="studio-section-label">{c.badge}</span>
      </div>

      <h1 class="page-main-headline reveal-on-scroll delay-100">
        {c.title}
      </h1>
      <p class="text-lead page-lead reveal-on-scroll delay-200">
        {c.lead}
      </p>
    </div>
  </section>

  <!-- Detailed Services List with Interactive Expandable Capability Accordions -->
  <section class="section-gap services-deep-section">
    <div class="container">
      <div class="services-deep-list">
        {services.map((service, sIdx) => (
          <article class={`service-detail-card reveal-on-scroll delay-${(sIdx + 1) * 100}`}>
            <div class="service-card-header">
              <div class="header-left">
                <span class="service-number">{service.num}</span>
                <span class="service-pill-tag">{service.tag}</span>
              </div>
              <h2 class="service-card-title">{service.name}</h2>
              <p class="service-card-summary">{service.summary}</p>
            </div>

            <!-- Interactive Expandable Capabilities -->
            <div class="capabilities-interactive-grid">
              {service.capabilities.map((cap, cIdx) => (
                <div class:list={["cap-accordion-box", { "is-open": cIdx === 0 }]}>
                  <button 
                    type="button" 
                    class="cap-accordion-trigger" 
                    aria-expanded={cIdx === 0 ? "true" : "false"}
                  >
                    <span class="cap-title">{cap.title}</span>
                    <span class="cap-icon-circle">
                      <svg class="plus-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                      <svg class="minus-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </span>
                  </button>
                  <div class="cap-accordion-body">
                    <p class="cap-detail">{cap.detail}</p>
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Vertical Breakdown -->
  <section class="section-gap industries-section section-paper">
    <div class="container">
      <div class="industries-header reveal-on-scroll">
        <span class="studio-section-label">
          <span class="contra-star contra-star-red">✦</span>
          {c.indBadge}
        </span>
        <h2 class="section-headline">{c.indTitle}</h2>
        <p class="text-lead" style="margin-top: 0.5rem; max-width: 680px;">
          {c.indLead}
        </p>
      </div>

      <div class="industries-stack">
        {industries.map((ind, idx) => (
          <div class={`industry-split-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
            <div class="industry-card-content">
              <div class="industry-card-meta">
                <span class="industry-number">{ind.num}</span>
                <span class="industry-badge-tag">{ind.badge}</span>
              </div>
              <h3 class="industry-headline">
                <span class:list={["contra-star", ind.starColor]}>✦</span>
                {ind.headline}
              </h3>
              <p class="industry-desc">{ind.desc}</p>
              <div class="industry-card-footer">
                <div class="industry-metric-highlight">
                  <span class="metric-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                    </svg>
                  </span>
                  <span class="metric-text">{ind.metric}</span>
                </div>
                <a href={getLocalizedPath(lang, '/proyectos')} class="industry-action-link">
                  <span>{ind.linkText}</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
