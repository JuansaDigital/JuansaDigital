</main>

<script>
  // Accordions logic for capability boxes
  function initCapabilityAccordions() {
    const accordions = document.querySelectorAll('.cap-accordion-box');
    accordions.forEach(box => {
      const trigger = box.querySelector('.cap-accordion-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = box.classList.contains('is-open');
        box.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  }

  initCapabilityAccordions();
</script>

