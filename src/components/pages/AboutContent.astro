<script>
  // Subtle interactive 3D card tilt for portrait
  const card = document.getElementById('portraitCard');
  if (card) {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      const rotateX = (-y / rect.height) * 8;
      const rotateY = (x / rect.width) * 8;
      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
    });

    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
    });
  }

  // Culture Accordions toggle logic
  const cultureTriggers = document.querySelectorAll('.culture-accordion-trigger');
  cultureTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const parent = trigger.closest('.culture-accordion-item');
      if (!parent) return;
      const isAlreadyOpen = parent.classList.contains('is-open');

      // Close other accordions for clean accordion behavior
      document.querySelectorAll('.culture-accordion-item').forEach((item) => {
        item.classList.remove('is-open');
        const btn = item.querySelector('.culture-accordion-trigger');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });

      if (!isAlreadyOpen) {
        parent.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

