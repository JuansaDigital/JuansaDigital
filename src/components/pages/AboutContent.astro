---

<main id="main-content" class="about-page section-paper">
  <!-- Header Hero with animated reveals -->
  <section class="studio-page-header">
    <div class="container">
      <div class="header-badges-row reveal-on-scroll">
        <span class="studio-section-label">{c.badge}</span>
      </div>

      <h1 class="page-main-headline reveal-on-scroll delay-100">
        {c.title}
      </h1>
      <p class="text-lead page-lead reveal-on-scroll delay-200">
        {c.lead}
      </p>
    </div>
  </section>

  <!-- Infinite Photo Reel -->
  <PhotoMarquee lang={lang} />

  <!-- Manifesto / Philosophy Block with interactive cards -->
  <section class="section-gap about-philosophy-section">
    <div class="container">
      <div class="editorial-columns">
        <!-- Sticky Left Column: Portrait with 3D Tilt Hover Effect -->
        <div class="col-sticky-title reveal-on-scroll">
          <span class="studio-section-label">
            <span class="contra-star contra-star-red">✦</span>
            {c.philoBadge}
          </span>
          <h2 class="section-headline">{c.philoTitle}</h2>
          
          <div class="portrait-card" id="portraitCard">
            <div class="portrait-media-wrap">
              <img 
                src="/images/juan-salinas-portrait.webp" 
                alt="Juan Salinas Calle · JuanSa Digital" 
                class="portrait-img"
                width="1024"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="portrait-caption">
              <span class="portrait-name">Juan Salinas Calle</span>
              <span class="portrait-role">{c.role}</span>
            </div>
          </div>
        </div>

        <!-- Flow Right Column -->
        <div class="col-content-flow">
          <div class="reveal-on-scroll">
            <p class="body-p">
              {c.bio1}
            </p>
            <p class="body-p" style="margin-top: 1.25rem;">
              {c.bio2}
            </p>
          </div>

          <!-- 3 Pillars List with Hover Micro-Interactions -->
          <div class="pillars-list">
            {pillars.map((pillar, i) => (
              <div class={`pillar-interactive-card reveal-on-scroll delay-${(i + 1) * 100}`}>
                <div class="pillar-card-header">
                  <span class="pillar-num">{pillar.num}</span>
                  <span class="pillar-metric-badge">{pillar.metric}</span>
                </div>
                <h3 class="pillar-title">{pillar.title}</h3>
                <p class="pillar-desc">{pillar.desc}</p>
              </div>
            ))}
          </div>

          <div class="philosophy-cta reveal-on-scroll">
            <a href={getLocalizedPath(lang, '/contacto')} class="pill-morph-btn">
              <span>{c.ctaBtn}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Culture Accordions ("La cultura que define lo que hacemos") -->
  <section class="section-gap culture-section section-paper">
    <div class="container">
      <div class="culture-header reveal-on-scroll">
        <span class="studio-section-label">
          <span class="contra-star contra-star-red">✦</span>
          {c.cultureBadge}
        </span>
        <h2 class="section-headline">{c.cultureTitle}</h2>
        <p class="text-lead" style="margin-top: 0.75rem; max-width: 720px;">
          {c.cultureLead}
        </p>
      </div>

      <div class="culture-accordions-list">
        {cultureItems.map((item, idx) => (
          <div class:list={["culture-accordion-item", { "is-open": idx === 0 }]}>
            <button 
              type="button" 
              class="culture-accordion-trigger" 
              aria-expanded={idx === 0 ? "true" : "false"}
            >
              <div class="trigger-left">
                <span class="culture-index">{item.num}</span>
                <div class="culture-titles">
                  <h3 class="culture-title">{item.title}</h3>
                  <p class="culture-sub">{item.subtitle}</p>
                </div>
              </div>
              <div class="trigger-right">
                <span class:list={["contra-star", item.starClass]}>✦</span>
                <span class="accordion-icon-circle">
                  <svg class="plus-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  <svg class="minus-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </span>
              </div>
            </button>
            <div class="culture-accordion-panel">
              <div class="culture-panel-inner">
                <p class="culture-desc-text">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Summary (Contra Contrast Dark Section with Hover Cards) -->
