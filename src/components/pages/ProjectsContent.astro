        <span class="studio-section-label">{c.badge}</span>
      </div>

      <h1 class="page-main-headline reveal-on-scroll delay-100">
        {c.title}
      </h1>
      <p class="text-lead page-lead reveal-on-scroll delay-200">
        {c.lead}
      </p>

      <!-- Dynamic Impact Stats Bar -->
      <div class="impact-stats-bar reveal-on-scroll delay-300">
        {impactStats.map((stat) => (
          <div class="impact-stat-item">
            <span class="stat-number">
              {stat.prefix || ""}<span class="counter-val" data-target={stat.target}>{stat.target}</span>{stat.suffix}
            </span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar reveal-on-scroll delay-400" id="portfolioFilterBar">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class:list={["filter-pill", { active: idx === 0 }]}
            data-filter={cat.id}
          >
            <span>{cat.label}</span>
            <span class="filter-count">({cat.count})</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- 2-Column Projects Grid on Contrast Black Canvas -->
  <section class="section-gap projects-archive-section section-black">
    <div class="container">
      <div class="contra-projects-grid" id="projectsGrid">
        {allProjects.map((project, idx) => (
          <article 
            class={`project-entry reveal-on-scroll delay-${((idx % 4) + 1) * 100}`} 
            data-category={project.category}
          >
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-card-link">
              <div class="project-image-box">
                <img 
                  src={project.image} 
                  alt={`${project.title} - ${project.subtitle}`} 
                  class="project-thumbnail"
                  loading="lazy"
                />
                <div class="project-hover-arrow">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </div>
              </div>
              
              <div class="project-meta-line">
                <div class="meta-left">
                  <h2 class="meta-title">{project.title}</h2>
                  <span class="meta-sub">{project.subtitle}</span>
                </div>
                <span class="meta-tag">{project.tag}</span>
