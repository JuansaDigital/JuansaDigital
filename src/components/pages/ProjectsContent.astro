    </div>
  </section>
</main>

<script>
  // Filter pill logic with smooth animated transitions
  const filterBtns = document.querySelectorAll('.filter-pill');
  const projectEntries = document.querySelectorAll('.project-entry');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      projectEntries.forEach(entry => {
        const entryCategory = entry.getAttribute('data-category');
        if (filterValue === 'todos' || entryCategory === filterValue) {
          (entry as HTMLElement).style.display = 'block';
          entry.classList.add('is-visible');
        } else {
          (entry as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Animated impact numbers
  function animateCounters() {
    const counters = document.querySelectorAll('.counter-val');
    counters.forEach(c => {
      const target = Number(c.getAttribute('data-target'));
      if (isNaN(target)) return;
      let count = 0;
      const speed = target > 50 ? 20 : 60;
      const step = Math.ceil(target / 25) || 1;

      const timer = setInterval(() => {
        count += step;
        if (count >= target) {
          c.textContent = String(target);
          clearInterval(timer);
        } else {
          c.textContent = String(count);
        }
      }, speed);
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCounters();
        observer.disconnect();
      }
    });
  }, { threshold: 0.3 });

  const statsSection = document.querySelector('.impact-stats-bar');
  if (statsSection) observer.observe(statsSection);
</script>

<style>
