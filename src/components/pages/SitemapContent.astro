      { title: "IA & Lab", path: "/ia-lab", desc: "Laboratorio de Inteligencia Artificial, optimización AEO y herramientas analíticas." },
      { title: "Blog & Perspectivas", path: "/blog", desc: "Artículos, guías técnicas y análisis sobre desarrollo web y marketing en el Caribe." },
      { title: "Contacto", path: "/contacto", desc: "Formulario de contacto, cotizaciones y canal directo de WhatsApp." }
    ]
  },
  en: {
    badge: "Architecture & Navigation",
    title: "Sitemap",
    lead: "Structured directory of all sections, services, case studies, and perspectives from JuanSa Digital.",
    xmlBtn: "View Official XML Sitemap (sitemap-index.xml)",
    col1Title: "Core Pages",
    col2Title: "Blog Articles",
    col3Title: "Case Studies & Platforms",
    pages: [
      { title: "Home", path: "/", desc: "Main landing with services overview, portfolio, and proprietary data platforms." },
      { title: "About", path: "/nosotros", desc: "Territorial philosophy, track record in Santa Marta, and background of Juan Salinas Calle." },
      { title: "Services", path: "/servicios", desc: "WordPress and Astro web engineering, destination marketing, SEO, Google Ads, and BI." },
      { title: "Projects", path: "/proyectos", desc: "Selected case studies across regional tourism, boutique eco-lodges, and corporate consulting." },
      { title: "AI & Lab", path: "/ia-lab", desc: "Artificial Intelligence exploration, AEO engine optimization, and custom scraping tools." },
      { title: "Blog & Perspectives", path: "/blog", desc: "Technical guides, industry analysis, and insights on web architecture and tourism growth." },
      { title: "Contact", path: "/contacto", desc: "Project inquiry form, proposal requests, and direct WhatsApp channel." }
    ]
  },
  fr: {
    badge: "Architecture & Navigation",
    title: "Plan du Site",
    lead: "Répertoire structuré de toutes les sections, services, études de cas et publications de JuanSa Digital.",
    xmlBtn: "Consulter le Sitemap XML Officiel (sitemap-index.xml)",
    col1Title: "Pages Principales",
    col2Title: "Articles du Blog",
    col3Title: "Études de Cas & Plateformes",
    pages: [
      { title: "Accueil", path: "/", desc: "Page principale avec aperçu des services, portfolio et plateformes d'analyse." },
      { title: "À Propos", path: "/nosotros", desc: "Philosophie territoriale, ancrage à Santa Marta et parcours de Juan Salinas Calle." },
      { title: "Services", path: "/servicios", desc: "Ingénierie web WordPress et Astro, marketing touristique, SEO, Google Ads et BI." },
      { title: "Projets", path: "/proyectos", desc: "Portfolio d'études de cas en tourisme régional, hôtellerie de charme et conseil." },
      { title: "IA & Lab", path: "/ia-lab", desc: "Laboratoire d'Intelligence Artificielle, optimisation AEO et outils analytiques." },
      { title: "Blog & Perspectives", path: "/blog", desc: "Guides techniques, analyse sectorielle et retours d'expérience sur le web touristique." },
      { title: "Contact", path: "/contacto", desc: "Formulaire de contact, demandes de devis et canal direct WhatsApp." }
    ]
  }
};

const t = copy[lang] || copy.es;

const featuredProjects = [
  { 
    name: "Hotel Parque Tayrona (Yachay)", 
    path: "/proyectos", 
    category: {
      es: "Eco-Hotel Boutique & Motor de Reservas",
      en: "Boutique Eco-Hotel & Booking Engine",
      fr: "Éco-Hôtel Boutique & Moteur de Réservation"
    } 
  },
  { 
    name: "Wiwa Tour", 
    path: "/proyectos", 
    category: {
      es: "Operador Ecoturístico & Sierra Nevada",
      en: "Ecotourism Operator & Sierra Nevada",
      fr: "Opérateur Écotouristique & Sierra Nevada"
    } 
  },
  { 
    name: "Visit Valle del Cauca", 
    path: "/proyectos", 
    category: {
      es: "Portal Turístico Departamental",
      en: "Departmental Tourism Portal",
      fr: "Portail Touristique Départemental"
    } 
  },
  { 
    name: "Discover La Guajira", 
    path: "/proyectos", 
    category: {
      es: "Destino Departamental & Cultura Wayuu",
      en: "Departmental Destination & Wayuu Culture",
      fr: "Destination Départementale & Culture Wayuu"
    } 
  },
  { 
    name: "Providencia Isla", 
    path: "/proyectos", 
    category: {
      es: "Plataforma Insular & Reserva de Biosfera",
      en: "Island Platform & Biosphere Reserve",
      fr: "Plateforme Insulaire & Réserve de Biosphère"
    } 
  },
  { 
    name: "Ciudad Perdida Santa Marta", 
    path: "/proyectos", 
    category: {
      es: "Portal Especializado & Posicionamiento SEO",
      en: "Specialized Portal & Organic SEO",
      fr: "Portail Spécialisé & Référencement SEO"
    } 
  },
  { 
    name: "Chez Boaz Tours", 
    path: "/proyectos", 
    category: {
      es: "Tours Boutique Internacionales",
      en: "Boutique International Tours",
      fr: "Tours Boutique Internationaux"
    } 
  },
  { 
    name: "Logan Valuation", 
    path: "/proyectos", 
    category: {
      es: "Avalúos Corporativos & MAI / IFRS Latam",
      en: "Corporate Valuations & MAI / IFRS Latam",
      fr: "Évaluations Corporatives & MAI / IFRS Latam"
    } 
  },
  { 
    name: "TurisData & SITUR Valledupar", 
    path: "/proyectos", 
    category: {
      es: "Inteligencia Territorial & Big Data RNT",
      en: "Territorial Intelligence & Big Data RNT",
      fr: "Intelligence Territoriale & Big Data RNT"
    } 
  }
];
---

<main id="main-content" class="sitemap-page section-paper">
  <section class="studio-page-header">
    <div class="container">
      <span class="studio-section-label reveal-on-scroll">
        <span class="contra-star contra-star-red">✦</span>
        {t.badge}
      </span>
      <h1 class="page-main-headline reveal-on-scroll delay-100">
        {t.title}
      </h1>
      <p class="text-lead page-lead reveal-on-scroll delay-200">
        {t.lead}
      </p>

      <div class="xml-badge-row reveal-on-scroll delay-300">
        <a href="/sitemap-index.xml" target="_blank" rel="noopener noreferrer" class="xml-chip-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>{t.xmlBtn}</span>
          <span class="chip-arrow">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sitemap-sections-wrap">
    <div class="container">
      <div class="sitemap-grid">
        <!-- Columna 1: Páginas Principales -->
        <div class="sitemap-card reveal-on-scroll delay-100">
          <div class="card-header">
            <span class="card-num">01</span>
            <h2 class="card-title">{t.col1Title}</h2>
          </div>
          <ul class="sitemap-list">
            {t.pages.map((page) => (
              <li class="sitemap-item">
                <a href={getLocalizedPath(page.path, lang)} class="item-link">
                  <span class="link-label">{page.title}</span>
                  <span class="item-arrow">→</span>
                </a>
                <p class="item-desc">{page.desc}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Columna 2: Artículos del Blog -->
        <div class="sitemap-card reveal-on-scroll delay-200">
          <div class="card-header">
            <span class="card-num">02</span>
            <h2 class="card-title">{t.col2Title}</h2>
          </div>
          <ul class="sitemap-list">
            {posts.map((post) => (
              <li class="sitemap-item">
                <a href={getLocalizedPath(`/blog/${post.slug}`, lang)} class="item-link">
                  <span class="link-label">{post.title}</span>
                  <span class="item-arrow">→</span>
                </a>
                <div class="post-meta-inline">
                  <span class="post-cat-badge">{post.category}</span>
                  <span class="post-date-tag">{post.date}</span>
                </div>
                <p class="item-desc">{post.excerpt}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Columna 3: Proyectos & Plataformas -->
        <div class="sitemap-card reveal-on-scroll delay-300">
          <div class="card-header">
            <span class="card-num">03</span>
            <h2 class="card-title">{t.col3Title}</h2>
          </div>
          <ul class="sitemap-list">
            {featuredProjects.map((proj) => (
              <li class="sitemap-item">
                <a href={getLocalizedPath(proj.path, lang)} class="item-link">
                  <span class="link-label">{proj.name}</span>
                  <span class="item-arrow">→</span>
                </a>
                <span class="project-cat-badge">{proj.category[lang] || proj.category.es}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  .sitemap-page {
    min-height: 100vh;
    padding-top: clamp(6.5rem, 10vw, 8.5rem);
    padding-bottom: 5rem;
  }

  .studio-page-header {
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .page-main-headline {
    font-size: clamp(2.5rem, 1.8rem + 3.2vw, 4.4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--ink-dark);
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }

  .page-lead {
    max-width: 680px;
    color: var(--ink-dark-muted);
  }

  .xml-badge-row {
    margin-top: 2rem;
  }

  .xml-chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-dark);
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .xml-chip-btn:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #60A5FA;
    transform: translateY(-2px);
  }

  .chip-arrow {
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .xml-chip-btn:hover .chip-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  .sitemap-sections-wrap {
    padding-bottom: 4rem;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .sitemap-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.5rem;
  }

  .card-num {
    font-family: monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--contra-red);
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink-dark);
    letter-spacing: -0.015em;
    margin: 0;
  }

  .sitemap-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sitemap-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .item-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink-dark);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .item-link:hover {
    color: #60A5FA;
    transform: translateX(4px);
  }

  .item-arrow {
    font-size: 0.9rem;
    opacity: 0.5;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .item-link:hover .item-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  .item-desc {
    font-size: 0.85rem;
    color: var(--ink-dark-muted);
    line-height: 1.45;
    margin: 0;
  }

  .post-meta-inline {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.15rem;
  }

  .post-cat-badge, .project-cat-badge {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #60A5FA;
    background: rgba(59, 130, 246, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    display: inline-block;
    width: fit-content;
  }

  .post-date-tag {
    font-size: 0.78rem;
    color: var(--ink-dark-dim);
  }

  @media (max-width: 1024px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
