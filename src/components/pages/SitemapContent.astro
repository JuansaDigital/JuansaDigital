    col2Title: "Artículos del Blog",
    col3Title: "Casos de Éxito & Plataformas",
    pages: [
      { title: "Inicio", path: "/", desc: "Página principal con resumen de servicios, portafolio y plataformas de datos." },
      { title: "Nosotros", path: "/nosotros", desc: "Filosofía, experiencia territorial en Santa Marta y perfil de Juan Salinas Calle." },
