---
import { getBlogPosts, getBlogPostBySlug, type BlogPost } from '../../data/blogPosts';
import { getLocalizedPath, type SupportedLanguage } from '../../i18n/ui';

interface Props {
  post: BlogPost;
  lang?: SupportedLanguage;
}

const { post: initialPost, lang = "es" } = Astro.props;
const post = getBlogPostBySlug(initialPost.slug, lang) || initialPost;
const otherPosts = getBlogPosts(lang).filter((p) => p.slug !== post.slug);

const copy = {
  es: {
    home: "Inicio",
    blog: "Blog",
    writtenBy: "Escrito por",
    bioDesc: "Consultor y estratega de marketing turístico, desarrollo web en WordPress y Astro, y analítica de datos en Santa Marta, Colombia. Impulsando la autonomía comercial del sector turístico.",
    waContact: "Contactar por WhatsApp ↗",
    aboutLink: "Conocer más sobre JuanSa Digital →",
    backBtn: "Volver a todas las publicaciones",
    relatedTitle: "Lecturas Recomendadas",
    readArticle: "Leer artículo"
  },
  en: {
    home: "Home",
    blog: "Blog",
    writtenBy: "Written by",
    bioDesc: "Tourism marketing consultant, WordPress & Astro web developer, and data analytics specialist based in Santa Marta, Colombia. Driving direct revenue for the travel industry.",
    waContact: "Contact via WhatsApp ↗",
    aboutLink: "Learn more about JuanSa Digital →",
    backBtn: "Back to all articles",
    relatedTitle: "Recommended Reading",
    readArticle: "Read article"
  },
  fr: {
    home: "Accueil",
    blog: "Blog",
    writtenBy: "Rédigé par",
    bioDesc: "Consultant en marketing touristique, développeur web WordPress & Astro et spécialiste de l'analyse de données à Santa Marta, Colombie. Développeur de l'autonomie commerciale touristique.",
    waContact: "Contacter sur WhatsApp ↗",
    aboutLink: "En savoir plus sur JuanSa Digital →",
    backBtn: "Retour à tous les articles",
    relatedTitle: "Lectures Recommandées",
    readArticle: "Lire l'article"
  }
};

const c = copy[lang] || copy.es;
---

<main id="main-content" class="article-single-page section-paper">
  <!-- Breadcrumbs -->
  <div class="article-breadcrumbs-wrap">
    <div class="container">
      <nav class="breadcrumbs-nav" aria-label="Ruta de navegación">
        <a href={getLocalizedPath(lang, '/')}>{c.home}</a>
        <span class="sep">/</span>
        <a href={getLocalizedPath(lang, '/blog')}>{c.blog}</a>
        <span class="sep">/</span>
        <span class="current" aria-current="page">{post.category}</span>
      </nav>
    </div>
  </div>

  <!-- Article Header -->
  <header class="article-header">
    <div class="container article-container">
      <div class="article-badge-row">
        <span class="article-category-badge">{post.category}</span>
        <span class="meta-dot">·</span>
        <time datetime={post.isoDate} class="article-pub-date">{post.date}</time>
        <span class="meta-dot">·</span>
        <span class="article-reading-time">{post.readTime}</span>
      </div>

      <h1 class="article-main-title">
        {post.title}
      </h1>

      <p class="article-lead-excerpt">
        {post.excerpt}
      </p>

      <!-- Author Byline -->
      <div class="article-author-row">
        <img 
          src={post.author.avatar} 
          alt={post.author.name} 
          class="author-avatar"
          width="52"
          height="52"
        />
        <div class="author-details">
          <span class="author-name">{post.author.name}</span>
          <span class="author-role">{post.author.role} · Santa Marta</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Featured Cover Image -->
  <div class="article-cover-wrap">
    <div class="container article-container">
      <div class="cover-frame">
        <img 
          src={post.image} 
          alt={post.title} 
          class="cover-image"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <!-- Article Content Flow (Typography Editorial) -->
  <section class="article-content-section">
    <div class="container article-container">
      <div class="article-body-prose" set:html={post.contentHtml} />

      <!-- Author Bio Box -->
      <div class="author-bio-card">
        <img 
          src={post.author.avatar} 
          alt={post.author.name} 
          class="bio-avatar"
          width="72"
          height="72"
        />
        <div class="bio-text">
          <span class="bio-label">{c.writtenBy}</span>
          <h3 class="bio-name">{post.author.name}</h3>
          <p class="bio-desc">
            {c.bioDesc}
          </p>
          <div class="bio-actions">
            <a href="https://wa.me/message/VZOWCP5BYGXJD1" target="_blank" rel="noopener noreferrer" class="bio-link">
              <span>{c.waContact}</span>
            </a>
            <a href={getLocalizedPath(lang, '/nosotros')} class="bio-link">
              <span>{c.aboutLink}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Back & Next Navigation -->
      <div class="article-footer-nav">
        <a href={getLocalizedPath(lang, '/blog')} class="back-to-blog-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{c.backBtn}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Articles -->
  {otherPosts.length > 0 && (
    <section class="section-gap related-articles-section">
      <div class="container article-container">
        <h2 class="related-heading">{c.relatedTitle}</h2>
        <div class="related-grid">
          {otherPosts.map((related) => (
            <article class="related-card">
              <span class="related-cat">{related.category}</span>
              <h3 class="related-title">
                <a href={getLocalizedPath(lang, `/blog/${related.slug}`)}>{related.title}</a>
              </h3>
              <p class="related-excerpt">{related.excerpt}</p>
              <a href={getLocalizedPath(lang, `/blog/${related.slug}`)} class="related-link">
                <span>{c.readArticle}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</main>

<style>
  .article-single-page {
    padding-bottom: 2rem;
  }

  .article-breadcrumbs-wrap {
    padding-top: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-light);
  }

  .breadcrumbs-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .breadcrumbs-nav a {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumbs-nav a:hover {
    color: var(--contra-red);
  }

  .breadcrumbs-nav .sep {
    color: var(--line-light);
  }

  .breadcrumbs-nav .current {
    color: var(--ink-primary);
    font-weight: 600;
  }

  .article-container {
    max-width: 820px;
    margin-inline: auto;
  }

  .article-header {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 2rem;
  }

  .article-badge-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .article-category-badge {
    color: var(--contra-red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-dot {
    color: var(--ink-dim);
  }

  .article-pub-date,
  .article-reading-time {
    color: var(--ink-muted);
  }

  .article-main-title {
    font-size: clamp(2.2rem, 1.8rem + 2.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--ink-primary);
    margin-bottom: 1.5rem;
  }

  .article-lead-excerpt {
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.3rem);
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line-light);
  }

  .article-author-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--line-light);
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .author-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink-primary);
  }

  .author-role {
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .article-cover-wrap {
    margin-bottom: 3.5rem;
  }

  .cover-frame {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #F1F5F9;
    border: 1px solid var(--line-light);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-content-section {
    padding-bottom: 4rem;
  }

  .article-body-prose {
    font-size: 1.12rem;
    line-height: 1.8;
    color: #1E293B;
  }

  .article-body-prose :global(p) {
    margin-bottom: 1.65rem;
  }

  .article-body-prose :global(.lead-paragraph) {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--ink-primary);
    font-weight: 500;
    margin-bottom: 2.25rem;
  }

  .article-body-prose :global(h2) {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink-primary);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
  }

  .article-body-prose :global(h3) {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    margin-top: 2rem;
    margin-bottom: 0.85rem;
  }

  .article-body-prose :global(ul) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  .article-body-prose :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.65;
  }

  .article-body-prose :global(code) {
    background: #F1F5F9;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--contra-red);
  }

  .author-bio-card {
    margin-top: 4rem;
    padding: 2.5rem;
    background: #FFFFFF;
    border: 1px solid var(--line-light);
    border-radius: 18px;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .bio-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--line-light);
  }

  .bio-text {
    display: flex;
    flex-direction: column;
  }

  .bio-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--contra-red);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .bio-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--ink-primary);
    margin-bottom: 0.5rem;
  }

  .bio-desc {
    font-size: 0.96rem;
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .bio-actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .bio-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--contra-red);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .bio-link:hover {
    opacity: 0.8;
  }

  .article-footer-nav {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line-light);
  }

  .back-to-blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink-primary);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .back-to-blog-link:hover {
    color: var(--contra-red);
    transform: translateX(-4px);
  }

  .related-articles-section {
    border-top: 1px solid var(--line-light);
    background: #FFFFFF;
  }

  .related-heading {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink-primary);
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .related-card {
    padding: 2rem;
    border: 1px solid var(--line-light);
    border-radius: 14px;
    background: var(--bg-paper);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--contra-red);
  }

  .related-cat {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--contra-red);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .related-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.65rem;
  }

  .related-title a {
    color: var(--ink-primary);
    text-decoration: none;
  }

  .related-excerpt {
    font-size: 0.92rem;
    color: var(--ink-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .related-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--contra-red);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .author-bio-card {
      flex-direction: column;
      padding: 1.75rem;
      gap: 1.25rem;
    }
  }
</style>
