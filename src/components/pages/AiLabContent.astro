const copy = {
  es: {
    badge: "Laboratorio de Inteligencia Artificial & Datos",
    headline: "Inteligencia artificial aplicada al turismo y analítica de datos.",
    sub: "Exploramos y construimos soluciones de datos: desde Answer Engine Optimization (AEO) para ser recomendados por Perplexity y ChatGPT, hasta web scraping de información turística para SITUR y plataformas territoriales como TurisData.",
