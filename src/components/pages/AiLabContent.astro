const c = copy[lang] || copy.es;
const aiPillars = aiPillarsData[lang] || aiPillarsData.es;
---

<main id="main-content" class="ai-page">
  <!-- Hero Header (High-contrast Contra Black Canvas) -->
  <section class="section-black ai-hero-section">
    <div class="container">
      <div class="ai-hero-tag reveal-on-scroll">
        <span class="studio-section-label red-label">
          <span class="contra-star contra-star-red">✦</span>
          {c.badge}
        </span>
      </div>

      <h1 class="ai-hero-headline reveal-on-scroll delay-100">
        {c.headline}
      </h1>
      <p class="ai-hero-sub reveal-on-scroll delay-200">
        {c.sub}
      </p>

      <!-- Interactive Telemetry Console Simulator -->
      <div class="telemetry-terminal-card reveal-on-scroll delay-300">
        <div class="terminal-topbar">
          <div class="terminal-dots">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          <div class="terminal-title">
            <span>juansa-telemetry-engine // v3.4.1</span>
          </div>
          <div class="terminal-status">
            <span class="status-indicator">● LIVE DEMO</span>
          </div>
        </div>

        <div class="terminal-controls-row">
          <button type="button" class="term-tab active" data-mode="aeo">
            <span>{c.tab1}</span>
          </button>
          <button type="button" class="term-tab" data-mode="scraping">
            <span>{c.tab2}</span>
          </button>
          <button type="button" class="term-tab" data-mode="turisdata">
            <span>{c.tab3}</span>
          </button>
        </div>

        <div class="terminal-screen" id="terminalScreen">
          <pre class="terminal-code" id="terminalCode"><code>// Inicializando motor de análisis AEO...
> Target: Hotel Boutique Sierra Nevada (Santa Marta)
> Analizando indexación semántica en Perplexity, ChatGPT & Gemini:
  [OK] llms.txt detectado y parseado correctamente (200 OK)
  [OK] Schema.org: LodgingBusiness, TouristAttraction validados
  [OK] Estructuración Semántica: Conforme a directrices de indexación
  [RESULT] Consulta: "Hotel ecológico en Santa Marta con reserva directa"
  -> ChatGPT Response: "Hotel Boutique Sierra Nevada (Reserva directa en sitio web oficial)."
  -> Canal directo habilitado: Sitio oficial verificado y reserva directa activa</code></pre>
        </div>

        <div class="terminal-footer">
          <span class="footer-note">{c.footerNote}</span>
          <button type="button" class="terminal-rerun-btn" id="rerunDemoBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>{c.rerunBtn}</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee Banner for AI Stack -->
  <div class="marquee-strip">
    <div class="marquee-track">
      <span class="marquee-item">AEO & PERPLEXITY <span class="sep"></span></span>
      <span class="marquee-item">LLMS.TXT ESTÁNDAR <span class="sep"></span></span>
      <span class="marquee-item">WEB SCRAPING TURÍSTICO <span class="sep"></span></span>
      <span class="marquee-item">TURISDATA · DATACORE AI <span class="sep"></span></span>
      <span class="marquee-item">LOOKER STUDIO SITUR <span class="sep"></span></span>
      <span class="marquee-item">INTELIGENCIA TERRITORIAL <span class="sep"></span></span>
      <!-- Duplicated for seamless loop -->
      <span class="marquee-item">AEO & PERPLEXITY <span class="sep"></span></span>
      <span class="marquee-item">LLMS.TXT ESTÁNDAR <span class="sep"></span></span>
      <span class="marquee-item">WEB SCRAPING TURÍSTICO <span class="sep"></span></span>
      <span class="marquee-item">TURISDATA · DATACORE AI <span class="sep"></span></span>
      <span class="marquee-item">LOOKER STUDIO SITUR <span class="sep"></span></span>
      <span class="marquee-item">INTELIGENCIA TERRITORIAL <span class="sep"></span></span>
    </div>
  </div>

  <!-- 4 AI Pillars Detail -->
  <section class="section-gap section-paper ai-pillars-section">
    <div class="container">
      <div class="ai-pillars-header reveal-on-scroll">
        <span class="studio-section-label">
          <span class="contra-star contra-star-red">✦</span>
          {c.pillarsBadge}
        </span>
        <h2 class="section-headline">{c.pillarsTitle}</h2>
        <p class="text-lead" style="margin-top: 0.5rem; max-width: 680px;">
          {c.pillarsLead}
        </p>
      </div>

      <div class="ai-pillars-grid">
        {aiPillars.map((pillar, idx) => (
          <article class={`ai-pillar-card reveal-on-scroll delay-${(idx + 1) * 100}`}>
            <div class="pillar-card-top">
              <span class="pillar-idx">{pillar.num}</span>
              <span class="pillar-tag">{pillar.tag}</span>
            </div>
            <h3 class="pillar-headline">
              <span class:list={["contra-star", pillar.starColor]}>✦</span>
              {pillar.title}
            </h3>
            <p class="pillar-text">{pillar.desc}</p>
            
            <div class="pillar-cap-list">
              <span class="cap-header">{c.deliverables}</span>
              <ul>
                {pillar.capabilities.map(cap => (
                  <li>
                    <span class="bullet-star">›</span>
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</main>

<script>
  // Interactive Telemetry Terminal Simulator
  const demoOutputs = {
    aeo: `// Initializing AEO Semantic Telemetry Engine...
> Target: Hotel Boutique Sierra Nevada (Santa Marta)
> Analyzing structured indexation across Perplexity, ChatGPT & Gemini:
  [OK] llms.txt standard detected and parsed (200 OK)
  [OK] Schema.org: LodgingBusiness, TouristAttraction verified
  [OK] Knowledge Graph Grounding: Structured for direct retrieval
  [RESULT] User Query: "Eco-boutique hotel in Santa Marta with direct booking"
  -> ChatGPT Citation: "Hotel Boutique Sierra Nevada (Direct reservation on official portal)."
  -> Direct Channel Active: Zero intermediary commission`,
    scraping: `// Starting Automated Regional Tourism Scraping Pipeline...
> Territory: Valledupar & Cesar / Santa Marta · Public Market Sources
> Extracting aggregated supply dynamics:
  [Lodgings] Total room inventory, room types, and verified registry
  [Tours & Agencies] Certified inbound operators, routes, and attractions
  [Restaurants] Regional gastronomy offerings and services
  [STATUS] Relational territorial database structured for SITUR
  [DASHBOARD] Interactive live views available in Google Looker Studio`,
    turisdata: `// Initializing TurisData Core AI (turisdata.tornus.agency)...
> Scope: Colombia (+1,100 Municipalities / 32 Departments)
> Synchronizing official geospatial layers:
  [RNT MINCIT] Records indexed: +1,280,000 hotel beds
  [MARKETS] International inflows: USA, Europe & Latam mapped
  [LUMINA AI] Strategic placebranding and competitiveness diagnostic completed
  -> Live platform active: https://turisdata.tornus.agency`
  };

  const tabs = document.querySelectorAll('.term-tab');
  const codeEl = document.getElementById('terminalCode');
  const rerunBtn = document.getElementById('rerunDemoBtn');
  let currentMode = 'aeo';

  function renderTerminal(mode: string) {
    if (!codeEl) return;
    currentMode = mode;
    const content = demoOutputs[mode as keyof typeof demoOutputs] || demoOutputs.aeo;
    codeEl.innerHTML = `<code>${content}</code>`;
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const mode = tab.getAttribute('data-mode') || 'aeo';
      renderTerminal(mode);
    });
  });

  if (rerunBtn) {
    rerunBtn.addEventListener('click', () => {
      if (!codeEl) return;
      codeEl.innerHTML = `<code>[RERUNNING TELEMETRY PIPELINE...]</code>`;
      setTimeout(() => {
        renderTerminal(currentMode);
      }, 350);
    });
  }
</script>

<style>
  .ai-hero-section {
    padding-top: clamp(4rem, 7vw, 7.5rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ai-hero-headline {
    font-size: clamp(2.5rem, 2rem + 3.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #FFFFFF;
    max-width: 980px;
    margin-bottom: 1.5rem;
  }

  .ai-hero-sub {
    font-size: clamp(1.15rem, 1rem + 0.4vw, 1.4rem);
    color: var(--ink-dark-muted);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: 3.5rem;
  }

  /* Telemetry Terminal Card */
  .telemetry-terminal-card {
    background: #090C12;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
  }

  .terminal-topbar {
    background: #11151F;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-dots {
    display: flex;
    gap: 0.4rem;
  }

  .dot-red, .dot-yellow, .dot-green {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.02em;
  }

  .status-indicator {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #10B981;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .terminal-controls-row {
    background: #0D111A;
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow-x: auto;
  }

  .term-tab {
    padding: 0.85rem 1.4rem;
    background: transparent;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.6);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .term-tab:hover {
    background: rgba(255, 255, 255, 0.03);
    color: #FFFFFF;
  }

  .term-tab.active {
    background: #090C12;
    color: var(--contra-red);
    font-weight: 700;
    border-bottom: 2px solid var(--contra-red);
  }

  .terminal-screen {
    padding: 2rem 2.25rem;
    min-height: 240px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.7;
    color: #A5B4FC;
    background: #090C12;
    overflow-x: auto;
  }

  .terminal-code code {
    font-family: inherit;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-footer {
    background: #11151F;
    padding: 0.85rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-note {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    font-family: var(--font-mono);
  }

  .terminal-rerun-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .terminal-rerun-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Marquee Strip */
  .marquee-strip {
    background: #000000;
    border-block: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    padding-block: 1rem;
  }

  .marquee-track {
    display: flex;
    white-space: nowrap;
    animation: marquee 28s linear infinite;
    gap: 3rem;
  }

  .marquee-item {
    font-family: var(--font-mono);
