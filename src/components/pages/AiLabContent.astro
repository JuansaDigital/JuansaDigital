    tab3: "03. TurisData Territorial AI",
    footerNote: "Real-time telemetry simulation based on JuanSa Digital architectures",
    rerunBtn: "Run Simulation",
    pillarsBadge: "Cutting-Edge Capabilities",
    pillarsTitle: "Data & Technology Engineering Pillars",
    pillarsLead: "Pragmatic solutions to decode regional market dynamics, structure public data, and scale your digital presence.",
    deliverables: "Key Deliverables:"
