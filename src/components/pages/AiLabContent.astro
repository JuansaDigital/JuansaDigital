    tab1: "01. Test Moteur AEO (Perplexity/ChatGPT)",
    tab2: "02. Scraping de l'Offre Touristique",
    tab3: "03. TurisData IA Territoriale",
    footerNote: "Simulation de télémétrie en direct basée sur les architectures de JuanSa Digital",
    rerunBtn: "Exécuter la Simulation",
    pillarsBadge: "Compétences de Pointe",
    pillarsTitle: "Nos Piliers de Données & Technologie",
